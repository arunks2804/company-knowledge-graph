{
  "name": "company-knowledge-graph-demo",
  "private": true,
  "description": "Playwright walkthroughs of the product workflows in PRODUCT.md, recorded as videos",
  "scripts": {
    "demo": "playwright test --grep-invert @reel",
    "demo:headed": "playwright test --grep-invert @reel --headed",
    "report": "playwright show-report",
    "reel": "playwright test --grep @reel --retries=3 && node make-reel.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
