# Local-only settings for the Playwright demo (docker compose services on localhost).
# The demo admin account below is created on first backend start; it is not for real use.
ADMIN_USERNAME=demo-admin
ADMIN_PASSWORD=kg-demo-local-only
ALLOWED_ORIGINS=http://localhost:5173

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=retail_db
POSTGRES_USER=kg_user
POSTGRES_PASSWORD=kg_pass

DYNAMODB_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

OLLAMA_BASE_URL=http://localhost:11434
LANGCHAIN_TRACING_V2=false
