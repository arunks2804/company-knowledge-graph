# Auth — bootstrap admin user (created on first startup if no users exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=retail_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Druid
DRUID_URL=http://localhost:8888

# DynamoDB / LocalStack
DYNAMODB_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# TimescaleDB
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_DB=tsdb
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=postgres

# Apache Iceberg (REST catalog)
ICEBERG_CATALOG_TYPE=rest
ICEBERG_CATALOG_URI=http://localhost:8181
ICEBERG_WAREHOUSE=s3://warehouse
ICEBERG_S3_ENDPOINT=http://localhost:9000

# LLM (set if using Anthropic or OpenAI instead of Ollama)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Ollama (if running locally outside Docker)
OLLAMA_BASE_URL=http://localhost:11434

# LangSmith tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=company-knowledge-graph
